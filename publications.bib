	series = {Methods in {Molecular} {Biology}},
	title = {Linking {Central} {Gene} {Expression} {Patterns} and {Mental} {States} {Using} {Transcriptomics} and {Large}-{Scale} {Meta}-{Analysis} of {fMRI} {Data}: {A} {Tutorial} and {Example} {Using} the {Oxytocin} {Signaling} {Pathway}},
