# NOTE: _site/ is deliberately NOT ignored. Netlify serves it directly, because
# its build image has no R and this site renders publications.qmd through knitr.
# Run `quarto render` before pushing or the deployed site will be stale.

/.quarto/
_freeze/
.Rproj.user
.Rhistory
.RData
.DS_Store

# Source documents kept locally, NOT published. The CV .docx contains personal
# details (date of birth, nationality) that must not go into a public repo.
*.docx
List of publications.pdf

# Working spreadsheet used to build the Talks page, not site source.
osf_presentations.xlsx

# Private working notes.
NOTES.md

# Rendering a post on its own (e.g. `quarto render posts/foo/index.qmd` to
# preview a draft) writes its output beside the source rather than into _site/.
# Those are build artifacts, not source.
posts/**/*_files/
posts/**/index.html


**/*.quarto_ipynb
